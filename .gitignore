# ESP-IDF build output
build/

# Host unit tests / simulator build dirs
tests/host/build/
simulator/build/

# Standalone LVGL clone for the simulator, used when no firmware build has
# populated managed_components/. See simulator/CMakeLists.txt.
simulator/.lvgl/

# CLion / generic CMake debug build dir
cmake-build-debug/

# Simulator --diff scratch output
docs/screenshots/actual/
sdkconfig
sdkconfig.old
sdkconfig.defaults.local

# Managed components (fetched during build)
managed_components/

# SPIFFS built assets (generated from web_ui)
spiffs_data/www/

# Web UI
# No trailing slash: a directory-only pattern does not match a *symlink* named
# node_modules, which is how a stray link got committed as a 120000 blob and
# broke npm/tsc in every fresh clone.
web_ui/node_modules
web_ui/dist/

# macOS
.DS_Store

# IDE / tools
.vscode/
.idea/
xcuserdata/
.cache/
# Ignore local .claude state, but share the web-session start hook + its settings.
.claude/*
!.claude/settings.json
!.claude/hooks/
*.swp
*.swo

# Generated / stray
.python-version
.superpowers/
.bisque_profile
# `idf.py clang-check` drops its report here
warnings.txt

graphify-out/
.gemini/settings.json