Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-unsafe-functions,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  misc-redundant-expression,
  readability-braces-around-statements,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-declaration,
WarningsAsErrors: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-narrowing-conversions,
  -bugprone-branch-clone,
  -bugprone-unsafe-functions,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  misc-redundant-expression,
  readability-braces-around-statements,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-redundant-declaration,
HeaderFilterRegex: '(main|components)/.*\.h$'
# HeaderFilterRegex also matches ESP-IDF's own components/ tree (and the
# component manager's managed_components/), and CI's gate fails on ANY finding
# regardless of path. IDF 6.1 + esp-clang 21 report ~2,900
# bugprone-macro-parentheses hits inside IDF headers, none of them ours.
ExcludeHeaderFilterRegex: '(/esp-idf/|/esp/idf/|/managed_components/)'
CheckOptions:
  - key: bugprone-assert-side-effect.AssertMacros
    value: 'assert,ESP_ERROR_CHECK'
