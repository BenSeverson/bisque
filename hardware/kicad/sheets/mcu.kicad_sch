	(text "WS2812B STATUS LED\nVDD dropped ~4.6V for 3.3V data margin"
		(at 147.3333 171.3475 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left)
		)
		(uuid "86fa5d30-af85-5d0c-8a1d-da63aa939fe1")
	)
	(text "USB-C\nnative USB flashing + ESD"
		(at 22 29.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left)
		)
		(uuid "8c774d6a-55cb-57fc-90b0-cef1eee3901f")
	)
	(text "SPI RETURN-PATH CAPS (PCB review 2026-10-05 item 5)\nC51-C54 sit on the board at the SPI bus's F.Cu/B.Cu transitions,\nnot at U1: a signal that changes outer layer changes reference plane\n(In1 GND to In2 +3V3), and the return current crosses between the\nplanes through the nearest 3V3-GND capacitor. One 0603 per via\ncluster, each with its own via to each plane."
		(at 146.05 123.19 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left)
		)
		(uuid "9a982ef2-95cf-4bfd-b78c-0f48c15e0685")
	)
	(text "RESET / BOOT"
		(at 22 150 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "af8c6493-402f-41dd-9b4a-5ce544940eb6")
	)
	(text "+5V BULK"
		(at 22 199 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "dcf440e9-ec4b-45a1-9f16-a932f9c95071")
	)
	(text "R54-R58 damp the four 40 MHz display lines and R39-R43 the display module's XPT2046\ntouch lines; both loom to J5. R72/R73 series-terminate SCLK and MOSI at U1's own pins,\nahead of every branch: SPI_SCLK_U1/SPI_MOSI_U1 are the pin-side stubs.\nR56 is also the SDO hedge - lift it if the panel does not tri-state J5.9 off the shared\nSPI_MISO. R50-R53 hold all four chip selects deasserted from power-on, before firmware\nconfigures any GPIO. J14 Qwiic and J7 5-8 (0.1 in) share I2C, pulled up by R44/R45."
		(at 258 146 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "fbb231e2-0cfd-4efe-9ae1-d7c5a590edba")
	)
	(text "PULL-UPS  chip selects idle high, I2C"
		(at 258 211 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "08d3c30f-b943-4c38-a6a9-28bf89ba72ca")
	)
	(text "DISPLAY LOOM ESD + HEADER 3V3 LIMIT  J5, J7/J14"
		(at 258 101 0)
