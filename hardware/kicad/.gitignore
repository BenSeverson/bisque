bisque-controller-backups/
_autosave-*

# Regenerable review byproducts (kicad-happy analyzer runs, datasheet cache)
analysis/
# datasheets/* rather than datasheets/: git cannot re-include a file whose
# parent directory is excluded, and REV-B-NOTES.md below is a hand-written
# deliverable, not cache.
datasheets/*
!datasheets/REV-B-NOTES.md

# floorplan.py's output; design.py records the placement it produced
generator/floorplan.json
generator/__pycache__/

# Per-stage snapshots from gen_sch.py / kicad_build.py (generator/stages.py).
# Written on every run; nothing reads them, they are there to be opened in
# KiCad at the stage a problem appeared rather than inferred from the
# finished board.
stages/
