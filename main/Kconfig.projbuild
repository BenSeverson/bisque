menu "Bisque Configuration"

    menu "Wi-Fi Settings"
        config KILN_WIFI_STA_SSID
            string "WiFi Station SSID"
            default ""
            help
                SSID of the Wi-Fi network to connect to.

        config KILN_WIFI_STA_PASS
            string "WiFi Station Password"
            default ""
            help
                Password of the Wi-Fi network.

        config KILN_WIFI_AP_SSID
            string "WiFi AP SSID"
            default "Bisque"
            help
                SSID for the fallback Access Point.

        config KILN_WIFI_AP_PASS
            string "WiFi AP Password"
            default "bisquesetup"
            help
                Password for the fallback AP (min 8 chars).
    endmenu

    menu "GPIO Pin Assignments"
        config KILN_PIN_SPI_MOSI
            int "SPI MOSI GPIO"
            default 11

        config KILN_PIN_SPI_MISO
            int "SPI MISO GPIO"
            default 13

        config KILN_PIN_SPI_SCLK
            int "SPI SCLK GPIO"
            default 12

        config KILN_PIN_TC_CS
            int "Thermocouple CS GPIO"
            default 10

        config KILN_PIN_SSR
            int "SSR Output GPIO"
            default 17

        config KILN_PIN_LCD_CS
            int "LCD CS GPIO"
            default 8

        config KILN_PIN_LCD_DC
            int "LCD DC GPIO"
            default 9

        config KILN_PIN_LCD_RST
            int "LCD RST GPIO"
            default 46

        config KILN_PIN_LCD_BL
            int "LCD Backlight GPIO"
            default 3

        config KILN_PIN_STATUS_LED
            int "Status LED GPIO (WS2812B)"
            default 48
            help
                GPIO connected to the on-board WS2812B status LED.

        config KILN_PIN_ALARM
            int "Alarm output GPIO (-1 = disabled)"
            default 7
            help
                GPIO for buzzer or relay triggered on firing complete or error.
                Set to -1 to disable.

        config KILN_PIN_VENT
            int "Vent relay GPIO (-1 = disabled)"
            default -1
            help
                GPIO for downdraft vent relay. Active during early firing stages
                below 700°C to exhaust combustion gases. Set to -1 to disable.

        config KILN_PIN_LID_SWITCH
            int "Lid/door switch GPIO (-1 = disabled)"
            default -1
            help
                GPIO input for a lid/door interlock switch. On the Bisque PCB
                this net is LID_SW, brought out on aux header J7 pin 6 (GPIO21),
                with +3V3 and GND on pins 1 and 2 of the same connector.

                When fitted, opening the lid during a firing de-energizes the
                elements. What happens to the running program depends on the
                "lid mode" setting: warn (report only), pause (hold the program
                clock, auto-resume on close) or interlock (elements off, program
                keeps running — the heat-treat oven convention).

                THIS IS NOT A SAFETY DEVICE. It is a supplementary, firmware-level
                interlock, and it does nothing if the firmware has crashed or the
                controller has lost power. The real protection is a mechanical
                microswitch wired in series with the element contactor. Fit one.

                Set to -1 to disable.

        config KILN_LID_SWITCH_OPEN_IS_LOW
            bool "Lid-open reads LOW"
            default n
            depends on KILN_PIN_LID_SWITCH >= 0
            help
                Which logic level means "lid open". Named for the level rather
                than for a switch type on purpose — "active high/low" reads
                ambiguously here and got this backwards once already.

                Leave this OFF for normally-closed wiring, the recommended
                arrangement: the shut lid holds the contact closed and pulls the
                input LOW against the internal pull-up, so lid-open is the
                pulled-up HIGH. A broken wire, a pulled connector or a failed
                switch all read HIGH, i.e. OPEN, and fail safe.

                Turn it ON only if your switch pulls the input low when the lid
                opens, and understand that a broken wire will then read "lid
                closed" — the interlock stops protecting you silently.

        config KILN_PIN_BTN_UP
            int "Button Up GPIO"
            default 4
            help
                GPIO for the Up/scroll-up navigation button (active-low with internal pull-up).

        config KILN_PIN_BTN_DOWN
            int "Button Down GPIO"
            default 5
            help
                GPIO for the Down/scroll-down navigation button (active-low with internal pull-up).

        config KILN_PIN_BTN_SELECT
            int "Button Select GPIO"
            default 1
            help
                GPIO for the Select/enter navigation button (active-low with internal pull-up).
                Long-press cycles between display screens.

        config KILN_PIN_BTN_LEFT
            int "Button Left GPIO"
            default 6
            help
                GPIO for the Left navigation button (active-low with internal pull-up).

        config KILN_PIN_BTN_RIGHT
            int "Button Right GPIO"
            default 2
            help
                GPIO for the Right navigation button (active-low with internal pull-up).
    endmenu

    menu "PID Defaults"
        config KILN_PID_KP
            int "Default Kp x1000"
            default 2000
            help
                Proportional gain multiplied by 1000 (e.g. 2000 = 2.0).

        config KILN_PID_KI
            int "Default Ki x1000"
            default 10
            help
                Integral gain multiplied by 1000 (e.g. 10 = 0.01).

        config KILN_PID_KD
            int "Default Kd x1000"
            default 50000
            help
                Derivative gain multiplied by 1000 (e.g. 50000 = 50.0).
    endmenu

    menu "Safety Limits"
        config KILN_MAX_SAFE_TEMP
            int "Default Max Safe Temperature (C)"
            default 1300

        config KILN_HARDWARE_MAX_TEMP
            int "Absolute Hardware Max Temperature (C)"
            default 1400
            help
                Cannot be overridden via settings. Emergency stop above this.
    endmenu

endmenu
