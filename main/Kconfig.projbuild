menu "Bisque Configuration"

    menu "Wi-Fi Settings"
        config KILN_WIFI_STA_SSID
            string "WiFi Station SSID"
            default ""
            help
                SSID of the Wi-Fi network to connect to.

        config KILN_WIFI_STA_PASS
            string "WiFi Station Password"
            default ""
            help
                Password of the Wi-Fi network.

        config KILN_WIFI_AP_SSID
            string "WiFi AP SSID"
            default "Bisque"
            help
                SSID for the fallback Access Point.

        config KILN_WIFI_AP_PASS
            string "WiFi AP Password"
            default "bisquesetup"
            help
                Password for the fallback AP (min 8 chars).
    endmenu

    menu "GPIO Pin Assignments"
        config KILN_PIN_SPI_MOSI
            int "SPI MOSI GPIO"
            default 11

        config KILN_PIN_SPI_MISO
            int "SPI MISO GPIO"
            default 13

        config KILN_PIN_SPI_SCLK
            int "SPI SCLK GPIO"
            default 12

        config KILN_PIN_TC1_CS
            int "Thermocouple CS GPIO"
            default 10

        config KILN_PIN_SSR1
            int "SSR Output GPIO"
            default 17
            help
                Trigger for the primary (zone 1) SSR output — the kiln's main
                heat output. Opto-isolated on the rev B board (LTV-817S, U8):
                GPIO -> 220 ohm series resistor -> opto LED -> shared SSR_EN
                return, driven from the 100 ms SSR window.

                Gated in hardware by the watchdog charge pump on
                KILN_PIN_WDT_KICK (GPIO 36, see below): if that pin stops
                toggling, or a rev B board is missing the SJ2 "WDT DEFEAT"
                jumper it currently needs (nothing kicks GPIO 36 yet), this
                output de-energizes regardless of what firmware commands.

        config KILN_PIN_LCD_CS
            int "LCD CS GPIO"
            default 8

        config KILN_PIN_LCD_DC
            int "LCD DC GPIO"
            default 9

        config KILN_PIN_LCD_RST
            int "LCD RST GPIO"
            default 46

        config KILN_PIN_LCD_BL
            int "LCD Backlight GPIO"
            default 3

        config KILN_PIN_STATUS_LED
            int "Status LED GPIO (WS2812B)"
            default 48
            help
                GPIO connected to the on-board WS2812B status LED.

        config KILN_PIN_ALARM
            int "Alarm output GPIO (-1 = disabled)"
            default 7
            help
                GPIO for buzzer or relay triggered on firing complete or error.
                Set to -1 to disable.

        config KILN_PIN_VENT
            int "Vent relay GPIO (-1 = disabled)"
            default 14
            help
                GPIO for downdraft vent relay. Active during early firing stages
                below 700°C to exhaust combustion gases.

                On the Bisque PCB this net is AUX1, driven through the
                ULN2003 aux bank (U6) and brought out on aux terminal J10
                pin 2 (GPIO14), with the external coil rail AUX_VP and the
                other two aux channels on pins 1, 3 and 4. The default
                matches that board.

                Set to -1 on any build with no vent relay fitted, including the
                perfboard build. That is not just cosmetic: a configured pin
                makes the firmware report ventActive over the API/WebSocket and
                put a VENT marker on the LCD status bar during early firing.
                "The vent is off" and "this kiln has no vent" are deliberately
                different facts here (#184), and a pin configured on a kiln with
                no relay collapses them.

        config KILN_PIN_AUX2
            int "Aux output channel 2 GPIO (-1 = disabled)"
            default 15
            help
                General-purpose auxiliary output. On the Bisque PCB this net is
                AUX2, driven through the ULN2003 aux bank (U6, the same
                Darlington array as AUX1/VENT) and brought out on aux
                terminal J10 pin 3 (GPIO15), sharing J10's AUX_VP coil rail
                and GND with the other aux channels.

                Reserved for the auxiliary output bank in docs/application-
                roadmap-and-pcb-provisions.md §3.3 — purge solenoid by
                default once firmware gains a driver for it (see
                docs/pin-assignments.md §5).

                NOTHING DRIVES THIS PIN YET. It is declared here so the board
                and the firmware agree on what is routed; setting it to a GPIO
                currently has no effect beyond documenting the intent.

                Set to -1 to disable.

        config KILN_PIN_AUX3
            int "Aux output channel 3 GPIO (-1 = disabled)"
            default 16
            help
                Third general-purpose auxiliary output. On the Bisque PCB this
                net is AUX3, driven through the same ULN2003 aux bank (U6)
                and brought out on aux terminal J10 pin 4 (GPIO16).

                See KILN_PIN_AUX2. NOTHING DRIVES THIS PIN YET either.

                Set to -1 to disable.

        config KILN_PIN_LID_SWITCH
            int "Lid/door switch GPIO (-1 = disabled)"
            default 4
            help
                GPIO input for a lid/door interlock switch. On the Bisque PCB
                this net is IN1, one of three protected dry-contact inputs
                brought out on terminal J11 pin 1 (GPIO4), with +3V3 and GND
                on the same connector. The default matches that board.

                IF YOU DO NOT FIT A LID SWITCH, YOU MUST DO ONE OF THESE:

                  * Fit a jumper between J11 pin 1 and J11's GND pin. That is
                    the same connection a shut lid makes, so the firmware reads
                    "lid closed" permanently, or
                  * set this option to -1.

                Do neither and the kiln will not heat. The input is pulled up
                (R13 10k on the PCB, plus the ESP32's internal pull-up), so an
                unconnected pin reads HIGH — which is "lid open" — and the
                interlock holds the SSR off for as long as it stays that way.
                On a perfboard build with nothing wired to this GPIO, the same
                thing happens via the internal pull-up alone.

                That is deliberate fail-safe behaviour for OPEN-CIRCUIT faults,
                not a bug: a broken wire, a pulled connector or a switch that
                fails open all read open, so none of them can defeat the
                interlock. The cost is that an un-jumpered board looks like a
                kiln that will not fire.

                It does NOT make the interlock immune to every fault. A short
                from the input conductor to GND, or a switch welded or jammed
                closed, both hold the pin LOW — which reads "lid shut" — so the
                interlock stays armed but never cuts the element when the lid is
                actually opened. A jumper fitted in place of a switch is by
                definition indistinguishable from that failure. Nothing in the
                firmware can detect either case, which is one more reason the
                mechanical interlock below is the real protection.

                When fitted, opening the lid during a firing de-energizes the
                elements. What happens to the running program depends on the
                "lid mode" setting: warn (report only), pause (hold the program
                clock, auto-resume on close — the default) or interlock
                (elements off, program keeps running — the heat-treat oven
                convention). Only "warn" leaves the elements alone.

                THIS IS NOT A SAFETY DEVICE. It is a supplementary, firmware-level
                interlock, and it does nothing if the firmware has crashed or the
                controller has lost power. The real protection is a mechanical
                microswitch wired in series with the element contactor. Fit one.

                Set to -1 to disable.

        config KILN_LID_SWITCH_OPEN_IS_LOW
            bool "Lid-open reads LOW"
            default n
            depends on KILN_PIN_LID_SWITCH >= 0
            help
                Which logic level means "lid open". Named for the level rather
                than for a switch type on purpose — "active high/low" reads
                ambiguously here and got this backwards once already.

                Leave this OFF for normally-closed wiring, the recommended
                arrangement: the shut lid holds the contact closed and pulls the
                input LOW against the internal pull-up, so lid-open is the
                pulled-up HIGH. A broken wire, a pulled connector or a failed
                switch all read HIGH, i.e. OPEN, and fail safe.

                Turn it ON only if your switch pulls the input low when the lid
                opens, and understand that a broken wire will then read "lid
                closed" — the interlock stops protecting you silently.

        config KILN_PIN_BTN_UP
            int "Button Up GPIO"
            default 38
            help
                GPIO for the Up/scroll-up navigation button (active-low with internal pull-up).

        config KILN_PIN_BTN_DOWN
            int "Button Down GPIO"
            default 39
            help
                GPIO for the Down/scroll-down navigation button (active-low with internal pull-up).

        config KILN_PIN_BTN_SELECT
            int "Button Select GPIO"
            default 42
            help
                GPIO for the Select/enter navigation button (active-low with internal pull-up).
                Long-press cycles between display screens.

        config KILN_PIN_BTN_LEFT
            int "Button Left GPIO"
            default 40
            help
                GPIO for the Left navigation button (active-low with internal pull-up).

        config KILN_PIN_BTN_RIGHT
            int "Button Right GPIO"
            default 41
            help
                GPIO for the Right navigation button (active-low with internal pull-up).

        config KILN_PIN_TC2_CS
            int "Thermocouple 2 CS GPIO (-1 = disabled)"
            default 35
            help
                Chip select for the second (load) MAX31856 on the shared SPI
                bus. Populated on the rev B board.

                NOTHING READS THIS PIN YET. The multi-channel thermocouple
                driver is a follow-on; this exists so the board and the
                firmware agree on what is routed.

                Set to -1 on any build with only one thermocouple fitted.

        config KILN_PIN_SSR2
            int "SSR zone 2 output GPIO (-1 = disabled)"
            default 21
            help
                Trigger for the second SSR zone, opto-isolated on the rev B
                board. Driven from the 100 ms SSR window rather than the 1 Hz
                firing tick, because zone 2 modulates simultaneously with
                zone 1.

                NOTHING DRIVES THIS PIN YET. Set to -1 on a single-zone kiln.

        config KILN_PIN_IN_GASFLOW
            int "Gas-flow interlock input GPIO (-1 = disabled)"
            default 2
            help
                Dry-contact input for a gas-flow switch on the atmosphere
                purge line. Same conditioning and fail-safe polarity as the
                lid switch: open contact reads HIGH, so a broken wire reads
                "no flow".

                NOTHING READS THIS PIN YET.

        config KILN_PIN_IN_SPARE
            int "Spare protected input GPIO (-1 = disabled)"
            default 1
            help
                Third dry-contact input, unassigned. Same conditioning as the
                lid and gas-flow inputs.

                NOTHING READS THIS PIN YET.

        config KILN_PIN_I2C_SDA
            int "I2C SDA GPIO (-1 = disabled)"
            default 18
            help
                I2C data. Carries the on-board ADE7953 current-metering IC and
                the Qwiic/STEMMA-QT expansion header.

                NO I2C DRIVER EXISTS YET.

        config KILN_PIN_I2C_SCL
            int "I2C SCL GPIO (-1 = disabled)"
            default 47
            help
                I2C clock. See KILN_PIN_I2C_SDA.

        config KILN_PIN_TOUCH_CS
            int "Touch controller CS GPIO (-1 = disabled)"
            default 5
            help
                Chip select for the XPT2046 resistive touch controller on the
                display module. The controller is on the LCD module, not on
                the Bisque PCB; its clock/data lines are the shared SPI bus.

                NO TOUCH DRIVER EXISTS YET.

        config KILN_PIN_TOUCH_IRQ
            int "Touch pen-down interrupt GPIO (-1 = disabled)"
            default 6
            help
                Pen-down interrupt from the XPT2046. Lets the firmware skip
                touch reads until a press occurs rather than polling.

                Set to -1 to poll instead.

        config KILN_PIN_WDT_KICK
            int "Hardware watchdog kick GPIO (-1 = disabled)"
            default 36
            help
                Square-wave output feeding the charge pump that gates both SSR
                opto channels. If the firmware stops toggling this pin - or
                wedges with it stuck high or stuck low - the pump decays and
                both SSRs de-energize within about a second.

                A charge pump needs TRANSITIONS, which is the whole point: a
                stuck level fails exactly like a stopped one.

                Firmware kicks this pin at 5 Hz (the 100 ms SSR timer
                toggles it), gated on safety_task's heartbeat so the kick
                stops when supervision stops - see components/safety/wdt_kick.h.

                That rate is sized for the MONOSTABLE retrigger circuit of
                issue #307, NOT for the as-built diode charge pump, which
                needs >= 250 Hz to hold its gate and fails outright above
                ~60 C. Until the board carries the monostable, a rev B board
                still runs with the WDT DEFEAT solder jumper fitted. A board
                with neither the jumper nor working watchdog hardware will
                not heat.

                Set to -1 on hardware without the watchdog circuit.
    endmenu

    menu "PID Defaults"
        config KILN_PID_KP
            int "Default Kp x1000"
            default 2000
            help
                Proportional gain multiplied by 1000 (e.g. 2000 = 2.0).

        config KILN_PID_KI
            int "Default Ki x1000"
            default 10
            help
                Integral gain multiplied by 1000 (e.g. 10 = 0.01).

        config KILN_PID_KD
            int "Default Kd x1000"
            default 50000
            help
                Derivative gain multiplied by 1000 (e.g. 50000 = 50.0).
    endmenu

    menu "Diagnostics"
        config KILN_LOG_BUFFER_BYTES
            int "Device log buffer (bytes)"
            default 6144
            range 1024 32768
            help
                Size of the in-RAM ring buffer that captures ESP_LOGx output for
                GET /api/v1/log and the web UI's diagnostics bundle. Allocated
                once at boot; the oldest lines are evicted when it fills. Larger
                buffers keep more history at the cost of heap, and the whole
                buffer is copied once per /api/v1/log request.
    endmenu

    menu "Safety Limits"
        config KILN_MAX_SAFE_TEMP
            int "Default Max Safe Temperature (C)"
            default 1300

        config KILN_HARDWARE_MAX_TEMP
            int "Absolute Hardware Max Temperature (C)"
            default 1400
            help
                Cannot be overridden via settings. Emergency stop above this.
    endmenu

endmenu
